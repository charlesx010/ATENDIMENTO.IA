# FRONTEND: somente URL e chave pública (anon/publishable), protegida por RLS.
VITE_SUPABASE_URL=https://SEU-PROJETO.supabase.co
VITE_SUPABASE_ANON_KEY=SUA_CHAVE_PUBLICAVEL

# SOMENTE SERVIDOR / NETLIFY FUNCTIONS. Nunca prefixar segredos com VITE_.
SUPABASE_URL=https://SEU-PROJETO.supabase.co
SUPABASE_ANON_KEY=SUA_CHAVE_PUBLICAVEL
SUPABASE_SERVICE_ROLE_KEY=CONFIGURAR_APENAS_NO_SERVIDOR
GROQ_API_KEY=CONFIGURAR_APENAS_NO_SERVIDOR

# Habilitar apenas em ambiente de testes, com dados fictícios e plano confirmado.
GROQ_TRANSCRIPTION_ENABLED=false
GROQ_CLINICAL_ENABLED=false
GROQ_NOTE_MODEL=openai/gpt-oss-120b

# Recursos pagos legados não são usados pela interface nova.
TEXT_AI_ENABLED=false
LEGACY_PAID_AI_ENABLED=false

# Cotas novas: ativar somente depois de aplicar a migração.
# Ausente/false preserva as rotas clássicas sem exigir tabela nova.
AI_USAGE_ENFORCEMENT=false
# Cotas operacionais por conta/operação, apenas no servidor. Não são cobrança.
AI_DOCUMENTATION_DAILY_LIMIT=30
AI_TRANSCRIPTION_DAILY_LIMIT=40
AI_BURST_LIMIT=3
