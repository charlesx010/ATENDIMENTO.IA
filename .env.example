# PUBLICAS: podem ficar no bundle do navegador (anon/publishable key com RLS)
VITE_SUPABASE_URL=https://SEU-PROJETO.supabase.co
VITE_SUPABASE_ANON_KEY=SUA_CHAVE_PUBLICAVEL

# SOMENTE SERVIDOR Netlify Functions: NUNCA prefixar com VITE_
SUPABASE_URL=https://SEU-PROJETO.supabase.co
SUPABASE_SERVICE_ROLE_KEY=SUA_CHAVE_SECRETA_SERVICE_ROLE

# SOMENTE SERVIDOR: chave publica, para login por /usuario, sem expor emails de contas
SUPABASE_ANON_KEY=SUA_CHAVE_PUBLICAVEL

# SOMENTE SERVIDOR: crie NOVA chave OpenAI e configure-a no Netlify.
# NAO use VITE_ nem coloque o segredo no GitHub ou no chat.
# Antes, REVOGUE a chave previamente compartilhada. Não reutilizar segredo comprometido.
OPENAI_API_KEY=COLE_CHAVE_NOVA_APENAS_NO_NETLIFY

# SOMENTE SERVIDOR: RECURSO DESATIVADO POR PADRAO!
# Alterar para true na Netlify APENAS após chave nova, orçamento aprovado,
# conta autorizada em Administracao e testes de privacidade concluídos.
TEXT_AI_ENABLED=false

# SOMENTE SERVIDOR: Groq no plano Free. Configure true apenas em Deploy Previews.
# FREE_TRANSCRIPTION_ENABLED segue aceito temporariamente durante a migração.
GROQ_API_KEY=COLE_APENAS_NO_NETLIFY
GROQ_TRANSCRIPTION_ENABLED=false
GROQ_CLINICAL_ENABLED=false
